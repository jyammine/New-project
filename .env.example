# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. This default matches `docker compose up -d db`.
# (When running the app itself with docker compose, this is overridden to point at the db container.)
DATABASE_URL=postgres://littlenest:littlenest@localhost:5432/littlenest
# Password for the docker compose database — change it on a server.
POSTGRES_PASSWORD=littlenest
# Random string, at least 32 characters. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Public URL of the site, without a trailing slash (read at runtime)
SERVER_URL=http://localhost:3000

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Checkout is disabled until these are set. Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at /api/stripe/webhook (or `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Set to true if you use Stripe Tax
STRIPE_AUTOMATIC_TAX=false
# With Stripe Tax: "inclusive" if shop prices include tax (common in the EU/UK/AU),
# "exclusive" if tax is added at checkout (common in the US/Canada)
STRIPE_TAX_BEHAVIOR=inclusive

# ─── Email (optional) ────────────────────────────────────────────────────────
# Without SMTP settings, emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=Little Nest

# ─── Media storage (optional) ────────────────────────────────────────────────
# Uploads are stored on disk in ./media (or MEDIA_DIR) unless an S3-compatible bucket is set.
# Use S3 for serverless hosting (e.g. Vercel) or multiple app instances.
MEDIA_DIR=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
